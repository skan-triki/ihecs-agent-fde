{
  "name": "ihecs-agent-fde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --max-warnings=0 --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "concept:check": "node scripts/check-concept.mjs",
    "review:check": "node scripts/check-reviews.mjs",
    "src:check": "node scripts/check-src.mjs",
    "design:check": "node scripts/check-design.mjs",
    "plan:ack": "node scripts/plan-ack.mjs",
    "test": "vitest run",
    "env:check": "node scripts/check-env.mjs",
    "diagnostic": "node scripts/hooks/session-onboarding.mjs --human --strict",
    "env:init": "node scripts/init-env.mjs",
    "env:public": "node scripts/vercel-env-public.mjs",
    "routes:check": "node scripts/http-check.mjs",
    "prod:check": "node scripts/check-production.mjs",
    "secrets:check": "node scripts/secrets-check.mjs",
    "rules:check": "node scripts/check-integrity.mjs",
    "rules:sync": "node scripts/sync-rules.mjs",
    "guards:test": "node scripts/test-guards.mjs",
    "check": "pnpm env:check && pnpm src:check && pnpm design:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "verify": "pnpm check && pnpm build",
    "build:vercel": "node scripts/check-concept.mjs --skip-template && pnpm rules:check && pnpm secrets:check && pnpm verify",
    "prepare": "husky"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-llm-core": "^0.37.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1"
}
