{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/guard-exec.mjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node scripts/hooks/pre-commit-reminder.mjs",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/guard-edit.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/post-edit-lint.mjs",
          "timeout": 40
        }
      ]
    },
    {
      "matcher": "^run_subagent$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/log-subagent.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/stop-gate.mjs",
          "timeout": 240
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/language-reminder.mjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node scripts/hooks/turn-base.mjs",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "node scripts/hooks/plan-pending.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hooks/session-onboarding.mjs",
          "timeout": 25
        }
      ]
    }
  ]
}
