# Modèle des variables d'environnement — à copier en `.env.local` (jamais commité).
# Chaque variable déclarée dans src/env.ts DOIT figurer ici (vérifié par `pnpm env:check`).
# Ne mettez JAMAIS de vraie valeur secrète dans ce fichier.

# [server] Clé Vercel AI Gateway (optionnelle en local ; sur Vercel, l'authentification OIDC est automatique).
AI_GATEWAY_API_KEY=

# [client] Nom public de l'application.
NEXT_PUBLIC_APP_NAME="MVP IHECS"
